{
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex",
      "tools": ["xelatex"]
    },
    {
      "name": "xelatex ×2",
      "tools": ["xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "xelatex ×2",
  "latex-workshop.latex.autoBuild.run": "onSave"
}
